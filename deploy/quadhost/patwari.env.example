# This file has no credentials. Keep the listener broad only inside the
# container; the Quadlet host publish is restricted to 192.168.16.169:8787.
# PATWARI_DATA_DIR is a subdirectory of the writable volume root
# (/var/lib/patwari-volume, mounted by patwari.container) rather than the
# mount root itself, so restore can stage a same-filesystem sibling next to
# it even though the container root filesystem is read-only.
PATWARI_DATA_DIR=/var/lib/patwari-volume/data
PATWARI_BIND_ADDR=0.0.0.0:8080
PATWARI_ADMIN_DELETION_ENABLED=false
PATWARI_MAX_CONCURRENCY=64
PATWARI_MAX_DOWNLOAD_CONCURRENCY=8
PATWARI_REQUEST_TIMEOUT=30s
PATWARI_INTEGRITY_SCAN_CONCURRENCY=4
PATWARI_INTEGRITY_SCAN_BUFFER_BYTES=65536
RUST_LOG=info
